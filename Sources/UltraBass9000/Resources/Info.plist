<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Required for Core Audio process taps. Without this key the TCC prompt never
	     appears and every tapped buffer arrives silently filled with zeros. -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>ULTRABASS:9000 needs to capture system audio so it can process and route it to your output devices.</string>

	<!-- Acoustic auto-sync listens on the built-in microphone. This is a different TCC service from
	     audio capture above, with the same failure mode when missing: no prompt, and the recording
	     is silently full of zeros. Note this does not contradict the IOProc stream-usage map that
	     suppresses a microphone prompt for the output aggregate — calibration records through its
	     own IOProc on the input device, and only while the user asks for it. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>ULTRABASS:9000 uses the microphone only during auto-sync, to hear a short test tone from each output device and measure how far apart they arrive.</string>

	<!-- Phase 5 flips this to true for a pure menu-bar app. Kept false during
	     development so the app has a Dock icon and is easy to quit. -->
	<key>LSUIElement</key>
	<false/>

	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string></string>
	<key>NSMainNibFile</key>
	<string></string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
